using Gtk 4.0;
using Gio 2.0;
using Adw 1;

template $GhosttyMediaPanel: Adw.Dialog {
  title: _("Background Media");
  content-width: 600;
  closed => $closed();

  Adw.ToastOverlay toast_overlay {
    Adw.ToolbarView {
      top-bar-style: flat;

      [top]
      Adw.HeaderBar {}

      Gtk.ScrolledWindow {
        min-content-height: 420;

        Adw.PreferencesPage {
          Adw.PreferencesGroup {
            title: _("Source");
            header-suffix: Gtk.Box {
              spacing: 6;

              Gtk.Button choose_button {
                label: _("Choose File…");
                styles [ "suggested-action" ]
                clicked => $choose_file();
              }

              Gtk.Button {
                label: _("Use Configuration");
                clicked => $use_configuration();
              }
            };

            Adw.EntryRow source_row {
              title: _("Image, video or URL");
              show-apply-button: true;
              apply => $source_applied();
            }

            Adw.ActionRow status_row {
              title: _("Status");

              [suffix]
              Gtk.Button retry_button {
                label: _("Retry");
                visible: false;
                clicked => $retry();
              }

              [suffix]
              Gtk.Button live_button {
                label: _("Go Live");
                visible: false;
                clicked => $go_live();
              }
            }
          }

          Adw.PreferencesGroup {
            title: _("Appearance");

            Adw.ComboRow fit_row {
              title: _("Fit");
              model: Gtk.StringList {
                strings [
                  _("contain"),
                  _("cover"),
                  _("stretch"),
                  _("none")
                ]
              };
              notify::selected => $fit_changed();
            }

            Adw.ComboRow position_row {
              title: _("Position");
              model: Gtk.StringList {
                strings [
                  _("center"),
                  _("top-left"),
                  _("top-center"),
                  _("top-right"),
                  _("center-left"),
                  _("center-right"),
                  _("bottom-left"),
                  _("bottom-center"),
                  _("bottom-right")
                ]
              };
              notify::selected => $position_changed();
            }

            Adw.ActionRow {
              title: _("Dim");

              [suffix]
              Gtk.Scale dim_scale {
                accessibility {
                  label: _("Dim");
                }
                orientation: horizontal;
                width-request: 200;
                adjustment: Gtk.Adjustment {
                  lower: 0;
                  upper: 1;
                  step-increment: 0.05;
                  page-increment: 0.05;
                };
                value-changed => $dim_changed();
              }
            }
          }

          Adw.PreferencesGroup {
            title: _("Playback");

            Adw.ActionRow {
              title: _("Playback");

              [suffix]
              Gtk.Button play_button {
                valign: center;
                label: _("Pause");
                clicked => $toggle_play();
              }

              [suffix]
              Gtk.Button off_button {
                valign: center;
                label: _("Turn Off");
                clicked => $turn_off();
              }
            }

            Adw.ActionRow seek_row {
              title: _("Time");
              visible: false;

              [suffix]
              Gtk.Label position_label {
                label: "0:00";
              }

              [suffix]
              Gtk.Scale seek_scale {
                orientation: horizontal;
                width-request: 200;
                hexpand: true;
                accessibility {
                  label: _("Seek");
                }
                adjustment: Gtk.Adjustment {
                  lower: 0;
                  upper: 1;
                  step-increment: 1;
                  page-increment: 10;
                };
                change-value => $seek_changed();
              }

              [suffix]
              Gtk.Label duration_label {
                label: "0:00";
              }
            }

            Adw.SwitchRow loop_row {
              title: _("Loop");
              notify::active => $loop_changed();
            }

            Adw.ActionRow {
              title: _("Volume");

              [suffix]
              Gtk.Scale volume_scale {
                accessibility {
                  label: _("Volume");
                }
                orientation: horizontal;
                width-request: 200;
                adjustment: Gtk.Adjustment {
                  lower: 0;
                  upper: 1;
                  step-increment: 0.05;
                  page-increment: 0.05;
                };
                value-changed => $volume_changed();
              }
            }

            Adw.SwitchRow background_row {
              title: _("Keep playing in background");
              notify::active => $background_changed();
            }

            Adw.ActionRow {
              title: _("Frame rate");

              [suffix]
              Gtk.Box {
                styles [ "linked" ]
                valign: center;

                Gtk.ToggleButton fps30_button {
                  label: _("30 fps");
                  toggled => $fps_toggled();
                }

                Gtk.ToggleButton fps60_button {
                  label: _("60 fps");
                  group: fps30_button;
                  toggled => $fps_toggled();
                }
              }
            }
          }

          Adw.PreferencesGroup {
            title: _("Diagnostics");

            Adw.ExpanderRow diag_row {
              title: _("Diagnostics");
              notify::expanded => $diagnostics_expanded();

              Adw.ActionRow gst_row {
                title: _("GStreamer URL player");
              }

              Adw.ActionRow ytdlp_row {
                title: _("yt-dlp");
              }
            }
          }

          Adw.PreferencesGroup {
            Gtk.Box {
              orientation: horizontal;
              spacing: 12;
              halign: end;
              margin-top: 12;

              Gtk.Button reset_button {
                label: _("Reset Changes");
                clicked => $reset();
              }

              Gtk.Button save_button {
                label: _("Save to Configuration");
                styles [ "suggested-action" ]
                clicked => $save();
              }
            }
          }
        }
      }
    }
  }
}
